<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.hamzador</groupId>
        <artifactId>batchrecover-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>batchrecover-core</artifactId>
    <name>batchrecover-core</name>
    <description>Framework-independent domain</description>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>storage-contract-tests</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>test-jar</goal></goals>
                        <configuration><includes><include>**/contract/**</include></includes></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.22.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.hamzador.batchrecover.core.domain.*</param>
                                <param>io.github.hamzador.batchrecover.core.service.RetryPolicy</param>
                                <param>io.github.hamzador.batchrecover.core.service.RecoverySettings</param>
                            </targetClasses>
                            <targetTests><param>io.github.hamzador.batchrecover.core.*Test</param></targetTests>
                            <threads>2</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
                            <jvmArgs>
                                <param>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</param>
                            </jvmArgs>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
